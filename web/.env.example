# PlanB Intelligence (internal research dashboard)

# PostgreSQL connection used by server components and server actions. Every query runs inside a
# transaction that switches to the `authenticated` role with the staff user's id in the JWT claims,
# so row-level security applies to the dashboard exactly as it would through Supabase.
DATABASE_URL=postgresql://planb:planb@127.0.0.1:5432/planb_dev

# dev      → pick a seeded development staff user from the header (refused when NODE_ENV=production)
# supabase → Supabase Auth session cookies (requires the two variables below)
PLANB_AUTH_MODE=dev
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Evidence document storage. local → files under PLANB_EVIDENCE_DIR (shared with the research worker).
PLANB_EVIDENCE_BACKEND=local
PLANB_EVIDENCE_DIR=../var/evidence
# supabase backend only — server-side secret, never exposed to the browser:
SUPABASE_SERVICE_ROLE_KEY=
